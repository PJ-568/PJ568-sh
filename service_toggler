#!/bin/bash

# Generic service manager using yad
# This script displays the status of a service and allows toggling it on/off
# Usage: service_toggler <service_name>

# 当前语言 | Current language
# 0: en-US, 1: zh-Hans-CN
CURRENT_LANG=0

# 支持的语言 | Supported languages
declare -A LANGUAGES=(
  ["en"]="0"
  ["en_US"]="0"
  ["en-US"]="0"
  ["zh"]="1"
  ["zh_CN"]="1"
  ["zh-CN"]="1"
  ["zh_Hans"]="1"
  ["zh-Hans"]="1"
  ["zh_Hans_CN"]="1"
  ["zh-Hans-CN"]="1"
)

# 颜色定义 | Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 本地化文本 | Localization texts
declare -A LOCALIZATION

# English texts
LOCALIZATION["en_title"]="Service Manager"
LOCALIZATION["en_text"]="Manage service status\nPlease check desired states and click OK to apply"
LOCALIZATION["en_active"]="Active"
LOCALIZATION["en_enabled"]="Enabled at boot"
LOCALIZATION["en_apply"]="Apply"
LOCALIZATION["en_close"]="Close"
LOCALIZATION["en_confirm"]="Settings applied"
LOCALIZATION["en_ok"]="OK"
LOCALIZATION["en_usage"]="Usage: $0 <service_name>"
LOCALIZATION["en_error"]="Error: Service '%s' does not exist"
LOCALIZATION["en_info"]="Information"

# Chinese texts
LOCALIZATION["zh_title"]="服务管理器"
LOCALIZATION["zh_text"]="管理服务状态\n请勾选所需状态后点击确认应用"
LOCALIZATION["zh_active"]="运行中"
LOCALIZATION["zh_enabled"]="开机自启"
LOCALIZATION["zh_apply"]="确认"
LOCALIZATION["zh_close"]="关闭"
LOCALIZATION["zh_confirm"]="设置已应用"
LOCALIZATION["zh_ok"]="确定"
LOCALIZATION["zh_usage"]="用法: $0 <服务名称>"
LOCALIZATION["zh_error"]="错误: 服务 '%s' 不存在"
LOCALIZATION["zh_info"]="信息"

# Function to get localized text
l10n() {
  local key=$1
  local lang_key=""
  
  case $CURRENT_LANG in
    0) lang_key="en_$key" ;;
    1) lang_key="zh_$key" ;;
    *) lang_key="en_$key" ;; # Default to English
  esac
  
  echo "${LOCALIZATION[$lang_key]}"
}

# 语言检测 | Language detection
detect_language() {
  local lang_code=$(echo ${LANG/_/-} | cut -d'.' -f1)
  
  # Try exact match first
  if [[ -n "${LANGUAGES[$lang_code]}" ]]; then
    CURRENT_LANG=${LANGUAGES[$lang_code]}
    return
  fi
  
  # Try prefix match
  for lang in "${!LANGUAGES[@]}"; do
    if [[ $lang_code == $lang* ]] || [[ $lang_code == *$lang ]]; then
      CURRENT_LANG=${LANGUAGES[$lang]}
      return
    fi
  done
  
  # Default to English
  CURRENT_LANG=0
}

# Detect current language
detect_language

# Check if service name is provided
if [ $# -eq 0 ]; then
    echo "Usage: $0 <service_name>"
    exit 1
fi

SERVICE_NAME=$1

# Check if service exists
if ! systemctl list-unit-files | grep -q "^$SERVICE_NAME.service"; then
    echo "Error: Service '$SERVICE_NAME' does not exist"
    exit 1
fi

# Function to get current service status
get_service_status() {
    if systemctl is-active --quiet $SERVICE_NAME; then
        echo "active"
    else
        echo "inactive"
    fi
}

# Function to get current service enable status
get_enable_status() {
    if systemctl is-enabled --quiet $SERVICE_NAME; then
        echo "enabled"
    else
        echo "disabled"
    fi
}

# Function to toggle service status
toggle_service() {
    local action=$1
    case $action in
        "start")
            pkexec systemctl start $SERVICE_NAME
            ;;
        "stop")
            pkexec systemctl stop $SERVICE_NAME
            ;;
        "enable")
            pkexec systemctl enable $SERVICE_NAME
            ;;
        "disable")
            pkexec systemctl disable $SERVICE_NAME
            ;;
    esac
}

# Show yad dialog with only checkboxes and OK/Cancel buttons
while true; do
    # Get current statuses
    service_status=$(get_service_status)
    enable_status=$(get_enable_status)
    
    # Set checkbox states
    if [ "$service_status" = "active" ]; then
        active_checked="TRUE"
    else
        active_checked="FALSE"
    fi
    
    if [ "$enable_status" = "enabled" ]; then
        enable_checked="TRUE"
    else
        enable_checked="FALSE"
    fi
    
    # Show yad dialog with only checkboxes and OK/Cancel buttons
    result=$(yad --form \
        --title="$SERVICE_NAME 服务管理器" \
        --text="管理 $SERVICE_NAME 服务状态\n请勾选所需状态后点击确认应用" \
        --field="运行中:CHK" $active_checked \
        --field="开机自启:CHK" $enable_checked \
        --button="确认:0" \
        --button="关闭:1")
    
    # Check if user clicked OK (0) or Cancel/Close (1)
    if [ $? -eq 0 ]; then
        # Parse result
        active_state=$(echo $result | cut -d '|' -f 1)
        enable_state=$(echo $result | cut -d '|' -f 2)
        
        # Apply service status changes
        if [ "$active_state" = "TRUE" ] && [ "$service_status" = "inactive" ]; then
            toggle_service "start"
        elif [ "$active_state" = "FALSE" ] && [ "$service_status" = "active" ]; then
            toggle_service "stop"
        fi
        
        # Apply enable status changes
        if [ "$enable_state" = "TRUE" ] && [ "$enable_status" = "disabled" ]; then
            toggle_service "enable"
        elif [ "$enable_state" = "FALSE" ] && [ "$enable_status" = "enabled" ]; then
            toggle_service "disable"
        fi
        
        # Show confirmation message
        yad --text="设置已应用" --button="确定:0" --title="信息"
    else
        # User clicked Cancel or closed the dialog
        break
    fi
done
